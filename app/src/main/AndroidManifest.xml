<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MoonBagsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoonBags">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@style/Theme.MoonBags.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.config.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.MoonBags">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TotalMarketCapReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_mcap">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/total_mcap_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SingleCoinReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_tile">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_coin_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PillReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_pill">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pill_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SparklineReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_spark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sparkline_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WatchlistReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_watch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PortfolioReceiver"
            android:exported="true"
            android:theme="@style/Theme.MoonBags.Widget"
            android:label="@string/widget_book">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/portfolio_widget_info" />
        </receiver>

    </application>
</manifest>
